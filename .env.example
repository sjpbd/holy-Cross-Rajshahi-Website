# Copy to .env and fill in. Never commit .env.
# DEBUG=true only on your own computer. On the server leave it unset (off).
DEBUG=true
# On the server set a long random value:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Payment gateway: "janatapay" for the real gateway, "stub" for local simulate buttons.
PAYMENT_GATEWAY=stub

JANATAPAY_BASE_URL=https://sandbox-pg.janatapay.com
JANATAPAY_USERNAME=
JANATAPAY_PASSWORD=
JANATAPAY_MERCHANT_UID=
# Raw Base64 public key exactly as provided by the bank (no PEM header/footer).
JANATAPAY_PUBLIC_KEY=

JANATAPAY_TIMEOUT=30
JANATAPAY_PAYMENT_WINDOW_MINUTES=20
JANATAPAY_CURRENCY=BDT

# Email (Gmail SMTP). Use a Google App Password, not the account password.
# Leave EMAIL_HOST_USER/PASSWORD empty to print emails to the console instead.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_FROM_NAME=Holy Cross School and College

# Base URL for links inside emails (PDF download link).
SITE_URL=https://holycrossrajshahi.edu.bd
